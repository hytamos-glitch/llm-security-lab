# Copie ce fichier en .env et adapte si besoin.
# Le vrai .env ne doit JAMAIS etre commite (voir .gitignore).

# --- LLM (Ollama) ---
OLLAMA_MODEL=llama3.2:3b
# En local : http://localhost:11434
# Depuis un conteneur Docker : http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# --- RAG ---
CHROMA_DIR=./app/data/chroma

# --- Sites du lab ---
LEGIT_SITE_URL=http://localhost:8081
TRAP_SITE_URL=http://localhost:8082

# --- Secret de demo (Semaine 2/3 : cible d'exfiltration) ---
# En vrai, un secret ne se met pas en clair. On le garde ici pour la demo pedagogique.
INTERNAL_API_KEY=DEMO-finora-internal-key-CHANGE-ME
# Code fictif du document confidentiel : ne doit jamais sortir de l'assistant.
SUPERVISOR_CODE=7731

# --- Securite (Semaine 3) ---
# 1 = defenses activees (defaut). 0 = baseline vulnerable (pour rejouer les attaques).
SECURE_MODE=1
# Plafond par virement (USD) au-dela duquel l'agent refuse.
TRANSFER_LIMIT=1000
# Hôtes supplémentaires que fetch_url peut lire (séparés par des virgules).
# Les sites du lab et localhost sont toujours autorisés.
ALLOWED_FETCH_HOSTS=
